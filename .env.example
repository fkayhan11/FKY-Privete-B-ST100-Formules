# ── AUTH ────────────────────────────────────────────────────────
AUTH_USER=admin@fky
AUTH_PASS=kademeliAlımçokönemli!
# En az 32 karakter rastgele string (örn: openssl rand -hex 32)
SESSION_SECRET=
# Login brute-force koruması
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX_FAILS=6
AUTH_RATE_LIMIT_BLOCK_MS=900000
AUTH_RATE_LIMIT_MAX_KEYS=20000

# Fiyat ve topbar için (Yahoo endpointleri)
# HOST boş bırakılırsa varsayılan 127.0.0.1 kullanılır. Ağdan erişim için 0.0.0.0 yazabilirsiniz.
HOST=127.0.0.1
PORT=3001
# Port doluysa otomatik olarak bir sonraki portlara geçiş deneme sayısı
PORT_RETRY_COUNT=5
# Yahoo/TV istekleri arasındaki minimum aralık (ms). Düşürmek hız kazandırır, çok düşürmek rate-limit riskini artırır.
REQUEST_INTERVAL_MS=300
# Dış veri sağlayıcıları için istek timeout (ms)
REQUEST_TIMEOUT_MS=15000
# Yahoo engelli/ağ sorunlu ortamlarda BIST fiyat fallback (TradingView scan)
PRICE_ALLOW_TV_FALLBACK=1
TV_PRICE_CACHE_MS=90000
TV_PRICE_CHUNK_SIZE=50
# Son çare: KAP snapshot finansallarından yaklaşık fiyat tahmini üret
PRICE_ALLOW_SNAPSHOT_ESTIMATE=1
# Ağ tamamen kapalıysa son başarılı lokal fiyat anlık görüntüsünü kullan
PRICE_ALLOW_LOCAL_SNAPSHOT_FALLBACK=1
PRICE_SNAPSHOT_RELOAD_MS=15000
PRICE_SNAPSHOT_PERSIST_MS=2000
# 1 yapılırsa canlı kaynakları beklemeden sadece lokal fiyat snapshot kullanır (tanı/kriz modu)
PRICE_FORCE_LOCAL_SNAPSHOT=0
# Ağ kaynak hatasında sağlayıcıyı geçici bekleme moduna al (ms)
PRICE_PROVIDER_COOLDOWN_MS=120000

# Fundamentals kaynağı: snapshot (önerilen) veya hybrid
FUND_SOURCE=snapshot
# 1=eksik finansal metrikleri istek sırasında senkron tamamla (doğruluk öncelikli)
FUND_SYNC_TOPUP=1
# 0=finansal veride yalnızca KAP kullan (önerilen), 1=Yahoo fundamental fallback aç
FUND_ALLOW_YAHOO_FUND=0
# Finansal metrik modu:
# - kap_truth  : KAP hesapları esas (varsayılan)
# - tv_parity  : TradingView metriklerini birebir yansıt (sapma karşılaştırması için)
FUND_METRIC_MODE=kap_truth
# TV parity cache süresi (ms) ve chunk boyutu
TV_PARITY_CACHE_MS=120000
TV_PARITY_CHUNK_SIZE=50

# Resmi makro kaynakları
# FRED API key zorunlu değildir (CSV endpoint fallback var), ama önerilir.
FRED_API_KEY=

# TCMB EVDS (resmi) key: https://evds2.tcmb.gov.tr/
EVDS_API_KEY=

# EVDS seri kodları (hesabındaki doğru kodlarla doldur)
EVDS_SERIES_USDTRY=TP.DK.USD.S.YTL
EVDS_SERIES_POLICY_RATE=
EVDS_SERIES_CPI=
EVDS_SERIES_GROWTH=
EVDS_SERIES_UNEMP=
